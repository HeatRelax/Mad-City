local function pivotCharacterToCFrame(targetCFrame, failConditionFn)
	if not guardSoloServer(failConditionFn) then
		return false
	end

	local character = getCharacter()
	if not character then
		warn("Character not found for teleport")
		return false
	end

	character:PivotTo(targetCFrame)
	return true
end

local function waitGuardedSeconds(seconds, failConditionFn)
	local deadline = os.clock() + seconds
	while os.clock() < deadline do
		if not guardSoloServer(failConditionFn) then
			return false
		end
		task.wait(0.1)
	end
	return true
end

local function executeFullSequence()
	waitForGameAndPlayerLoaded()
	bindDeathRejoin()

	if not guardSoloServer(isJewelLocked) then
		return
	end

	-- 1. Switch to Criminals and immediately TP to Jewelry vent top
