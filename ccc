local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local VirtualUser = game:GetService("VirtualUser")

local player = Players.LocalPlayer

-- Destinations
local VENT_DESTINATION = Vector3.new(-77, 120, 813)
local CLUB_DESTINATION = Vector3.new(1328, 146, -127)
local CASINO_DESTINATION = Vector3.new(1655, 26, 524)
local BANK_DESTINATION = Vector3.new(763, 1, 479)

-- Tuning
local BOX_TWEEN_SPEED = 75
local BOX_Y_OFFSET = -6
local FIRES_PER_BOX = 3
local FIRES_PER_LEVER = 1
local VENT_WAIT_SECONDS = 4
local COLLECT_WAIT_SECONDS = 1.5
local LEVER_REFIRE_INTERVAL = 1.5
local IDLE_CHECK_INTERVAL = 0.25 -- poll rate while other players are present
local HIDE_SNAP_DISTANCE = 5 -- re-pivot to FINAL_CFRAME if drifted further than this
local ANTI_AFK_INTERVAL = 60 -- seconds between anti-AFK nudges while idling

-- Targets
local JEWEL_TARGET_CASH = "$5000"
local CLUB_TARGET_CASH = "$6000"
local CASINO_TARGET_CASH = "$4000"
local BANK_TARGET_CASH = "$3000"
local MAX_FARM_SECONDS = 120

-- Rejoin / respawn
local FINAL_CFRAME = CFrame.new(2137, 26, 363)
local REJOIN_DELAY_SECONDS = 0.5
local QUEUE_RESPAWN_HANDLER = false

--------------------------------------------------------------------------------
-- STATE
--------------------------------------------------------------------------------

local isRejoining = false
local isSwitchingTeam = false
local isHiding = false -- true while another player is in the server and we are idling
local isMidHeist = false -- true between "heist started" and "cash collected"
local deathConn = nil
local charAddedConn = nil
local currentStepText = "Starting..."
local stepLabelRef = nil

--------------------------------------------------------------------------------
-- CORE HELPERS
--------------------------------------------------------------------------------

local function setStepStatus(text)
	currentStepText = tostring(text)
	if stepLabelRef and stepLabelRef.Parent then
		stepLabelRef.Text = "Step: " .. currentStepText
	end
end

local function getLocalPlayer()
	if player and player.Parent then
		return player
	end
	player = Players.LocalPlayer
	while not player do
		player = Players.LocalPlayer
		if not player then
			task.wait(0.1)
		end
	end
	return player
end

local function getCharacter()
	return getLocalPlayer().Character
end

local function getRoot()
	local character = getCharacter()
	return character and (character:FindFirstChild("HumanoidRootPart") or character:FindFirstChildWhichIsA("BasePart"))
end

local function getHumanoid()
	local character = getCharacter()
	return character and character:FindFirstChildOfClass("Humanoid")
end

local function hasOtherPlayers()
	return #Players:GetPlayers() > 1
end

local function isPlayerDead()
	if isSwitchingTeam or isHiding then
		return false
	end
	local humanoid = getHumanoid()
	if not humanoid then
		return false
	end
	return humanoid.Health <= 0 or humanoid:GetState() == Enum.HumanoidStateType.Dead
end

--------------------------------------------------------------------------------
-- HEIST STATUS
--------------------------------------------------------------------------------

local function getHeistLockedValue(heistName)
	local heistStatus = ReplicatedStorage:FindFirstChild("HeistStatus")
	local heist = heistStatus and heistStatus:FindFirstChild(heistName)
	local locked = heist and heist:FindFirstChild("Locked")
	if locked and locked:IsA("BoolValue") then
		return locked
	end
	return nil
end

-- Generic checker: missing Locked value => treat as closed (except Jewel, where missing => open)
local function makeLockedChecker(heistName, treatMissingAsLocked)
	return function()
		local locked = getHeistLockedValue(heistName)
		if not locked then
			return treatMissingAsLocked and true or false
		end
		return locked.Value ~= false
	end
end

local isJewelLocked = makeLockedChecker("Jewel", false)
local isClubLocked = makeLockedChecker("Club", true)
local isCasinoLocked = makeLockedChecker("Casino", true)
local isBankLocked = makeLockedChecker("Bank", true)

--------------------------------------------------------------------------------
-- REJOIN
--------------------------------------------------------------------------------

local function getQueueTeleportFn()
	if type(queueteleport) == "function" then
		return queueteleport
	end
	if type(queue_on_teleport) == "function" then
		return queue_on_teleport
	end
	return nil
end

local function rejoinSameServer(queueHandler)
	if isRejoining then
		return
	end
	isRejoining = true
	setStepStatus("Rejoining server...")

	local lp = getLocalPlayer()
	local placeId = game.PlaceId
	local jobId = game.JobId
	local character = getCharacter()
	local data = character and character:GetPivot() or FINAL_CFRAME

	if queueHandler then
		local queueFn = getQueueTeleportFn()
		if queueFn then
			local handlerSource = type(queueHandler) == "string" and queueHandler or [[
				local Players = game:GetService("Players")
				local lp = Players.LocalPlayer
				local joinData = lp:GetJoinData()
				local teleportData = joinData and joinData.TeleportData
				if typeof(teleportData) == "CFrame" then
					lp.CharacterAdded:Wait()
					task.wait(0.2)
					if lp.Character then
						lp.Character:PivotTo(teleportData)
					end
				end
			]]
			pcall(queueFn, handlerSource)
		else
			warn("Incompatible Exploit: missing queue_on_teleport / queueteleport")
		end
	end

	if REJOIN_DELAY_SECONDS and REJOIN_DELAY_SECONDS > 0 then
		task.wait(REJOIN_DELAY_SECONDS)
	end

	if #Players:GetPlayers() <= 1 or jobId == "" then
		lp:Kick("\nRejoining...")
		task.wait(0.3)
		TeleportService:Teleport(placeId, lp, data)
	else
		TeleportService:TeleportToPlaceInstance(placeId, jobId, lp, nil, data)
	end
end

