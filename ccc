local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer

local VENT_DESTINATION = Vector3.new(-77, 120, 813)
local CLUB_DESTINATION = Vector3.new(1328, 146, -127)
local CASINO_DESTINATION = Vector3.new(1655, 26, 524)
local BANK_DESTINATION = Vector3.new(763, 1, 479)
local BOX_TWEEN_SPEED = 75
local BOX_Y_OFFSET = -6
local FIRES_PER_BOX = 3
local FIRES_PER_LEVER = 1
local VENT_WAIT_SECONDS = 4
local COLLECT_WAIT_SECONDS = 1.5
local JEWEL_TARGET_CASH = "$5000"
local CLUB_TARGET_CASH = "$6000"
local CASINO_TARGET_CASH = "$4000"
local BANK_TARGET_CASH = "$3000"
local MAX_FARM_SECONDS = 120
local FINAL_CFRAME = CFrame.new(2137, 26, 363)
local REJOIN_DELAY_SECONDS = 0.5
local QUEUE_RESPAWN_HANDLER = false

local isRejoining = false
local isSwitchingTeam = false
local deathConn = nil
local charAddedConn = nil

local function getLocalPlayer()
	if player and player.Parent then
		return player
	end
	player = Players.LocalPlayer
	while not player do
		player = Players.LocalPlayer
		if not player then
			task.wait(0.1)
		end
	end
	return player
end

local function getCharacter()
	local lp = getLocalPlayer()
	return lp.Character
end

local function getRoot()
	local character = getCharacter()
	return character and (character:FindFirstChild("HumanoidRootPart") or character:FindFirstChildWhichIsA("BasePart"))
end

local function getHumanoid()
	local character = getCharacter()
	return character and character:FindFirstChildOfClass("Humanoid")
end

local function hasOtherPlayers()
	return #Players:GetPlayers() > 1
end

local function getHeistLockedValue(heistName)
	local heistStatus = ReplicatedStorage:FindFirstChild("HeistStatus")
	local heist = heistStatus and heistStatus:FindFirstChild(heistName)
	local locked = heist and heist:FindFirstChild("Locked")
	if locked and locked:IsA("BoolValue") then
		return locked
	end
	return nil
end

local function isJewelLocked()
	local locked = getHeistLockedValue("Jewel")
	return locked and locked.Value == true or false
end

local function isClubLocked()
	local locked = getHeistLockedValue("Club")
	if not locked then
		return true
	end
	return locked.Value ~= false
end

local function isCasinoLocked()
	local locked = getHeistLockedValue("Casino")
	if not locked then
		return true
	end
	return locked.Value ~= false
end

local function isBankLocked()
	local locked = getHeistLockedValue("Bank")
	if not locked then
		return true
	end
	return locked.Value ~= false
end

local function isPlayerDead()
	if isSwitchingTeam then
		return false
	end
	local humanoid = getHumanoid()
	if not humanoid then
		return false
	end
	return humanoid.Health <= 0 or humanoid:GetState() == Enum.HumanoidStateType.Dead
end

local function getQueueTeleportFn()
	if type(queueteleport) == "function" then
		return queueteleport
	end
	if type(queue_on_teleport) == "function" then
		return queue_on_teleport
	end
	return nil
end

local function rejoinSameServer(queueHandler)
	if isRejoining then
		return
	end
	isRejoining = true

	local lp = getLocalPlayer()
	local placeId = game.PlaceId
	local jobId = game.JobId
	local character = getCharacter()
	local data = character and character:GetPivot() or FINAL_CFRAME

	if queueHandler then
		local queueFn = getQueueTeleportFn()
		if queueFn then
			local handlerSource = type(queueHandler) == "string" and queueHandler or [[
				local Players = game:GetService("Players")
				local lp = Players.LocalPlayer
				local joinData = lp:GetJoinData()
				local teleportData = joinData and joinData.TeleportData
				if typeof(teleportData) == "CFrame" then
					lp.CharacterAdded:Wait()
					task.wait(0.2)
					if lp.Character then
						lp.Character:PivotTo(teleportData)
					end
				end
			]]
			pcall(queueFn, handlerSource)
		else
			warn("Incompatible Exploit: missing queue_on_teleport / queueteleport")
		end
	end

	if REJOIN_DELAY_SECONDS and REJOIN_DELAY_SECONDS > 0 then
		task.wait(REJOIN_DELAY_SECONDS)
	end

	if #Players:GetPlayers() <= 1 or jobId == "" then
		lp:Kick("\nRejoining...")
		task.wait(0.3)
		TeleportService:Teleport(placeId, lp, data)
	else
		TeleportService:TeleportToPlaceInstance(placeId, jobId, lp, nil, data)
	end
end

local function guardHeistCondition(failConditionFn)
	if failConditionFn() then
		rejoinSameServer(QUEUE_RESPAWN_HANDLER)
		return false
	end
	return true
end

local function guardSoloServer(failConditionFn)
	if failConditionFn and not guardHeistCondition(failConditionFn) then
		return false
	end

	if isPlayerDead() then
		rejoinSameServer(QUEUE_RESPAWN_HANDLER)
		return false
	end

	if not hasOtherPlayers() then
		return true
	end

	while hasOtherPlayers() and not isPlayerDead() do
		if failConditionFn and not guardHeistCondition(failConditionFn) then
			return false
		end
		task.wait(0.25)
	end

	if failConditionFn and not guardHeistCondition(failConditionFn) then
		return false
	end

	if isPlayerDead() then
		rejoinSameServer(QUEUE_RESPAWN_HANDLER)
		return false
	end

	return true
end

local function waitForGameAndPlayerLoaded()
	if not game:IsLoaded() then
		game.Loaded:Wait()
	end

	local lp = getLocalPlayer()
	while not lp.Character or not lp.Character.Parent do
		lp.CharacterAdded:Wait()
		task.wait(0.1)
	end

	local character = lp.Character
	local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 30)
	local root = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 30)

	while not humanoid or not root or humanoid.Health <= 0 do
		task.wait(0.1)
		character = lp.Character
		if not character or not character.Parent then
			lp.CharacterAdded:Wait()
			character = lp.Character
		end
		if character then
			humanoid = humanoid or character:FindFirstChildOfClass("Humanoid")
			root = root or character:FindFirstChild("HumanoidRootPart")
		end
	end

	if not Workspace.CurrentCamera then
		Workspace:GetPropertyChangedSignal("CurrentCamera"):Wait()
	end

	task.wait(0.3)
end

local function bindDeathRejoin()
	local lp = getLocalPlayer()

	if deathConn then
		deathConn:Disconnect()
		deathConn = nil
	end
	if charAddedConn then
		charAddedConn:Disconnect()
		charAddedConn = nil
	end

	local function hookCharacter(char)
		if not char then
			return
		end
		if deathConn then
			deathConn:Disconnect()
			deathConn = nil
		end
		local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 30)
		if hum then
			deathConn = hum.Died:Connect(function()
				if not isSwitchingTeam then
					rejoinSameServer(QUEUE_RESPAWN_HANDLER)
				end
			end)
		end
	end

	hookCharacter(lp.Character)
	charAddedConn = lp.CharacterAdded:Connect(hookCharacter)
end

local function setTeamToCriminals()
	local remoteFunc = ReplicatedStorage:FindFirstChild("RemoteFunction") or ReplicatedStorage:WaitForChild("RemoteFunction", 15)
	if not remoteFunc or not remoteFunc:IsA("RemoteFunction") then
		warn("ReplicatedStorage.RemoteFunction not found")
		return false
	end

	local ok, err = pcall(function()
		remoteFunc:InvokeServer("SetTeam", "Criminals")
	end)

	if not ok then
		warn("Failed to invoke SetTeam Criminals:", tostring(err))
		return false
	end

	return true
end

local function switchToCriminalsAndRespawn()
	local previousCharacter = getCharacter()
	isSwitchingTeam = true
	setTeamToCriminals()

	local lp = getLocalPlayer()
	local deadline = os.clock() + 20
	local newChar = lp.Character

	if previousCharacter and newChar == previousCharacter then
		while os.clock() < deadline do
			newChar = lp.Character
			if newChar and newChar ~= previousCharacter and newChar.Parent then
				break
			end
			task.wait(0.05)
		end
	end

	while os.clock() < deadline do
		newChar = lp.Character
		if newChar and newChar.Parent then
			local hum = newChar:FindFirstChildOfClass("Humanoid")
			local root = newChar:FindFirstChild("HumanoidRootPart")
			if hum and root and hum.Health > 0 then
				isSwitchingTeam = false
				bindDeathRejoin()
				return newChar
			end
		end
		task.wait(0.05)
	end

	isSwitchingTeam = false
	bindDeathRejoin()
	return lp.Character
end

local function getInstancePosition(target)
	if not target then
		return nil
	end

	if target:IsA("BasePart") then
		return target.Position
	end

	if target:IsA("Model") then
		local primary = target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart", true)
		if primary then
			return primary.Position
		end
	end

	local part = target:FindFirstChildWhichIsA("BasePart", true)
	return part and part.Position
end

local function setCharacterNoclip(enabled)
	local character = getCharacter()
	if not character then
		return
	end

	for _, desc in ipairs(character:GetDescendants()) do
		if desc:IsA("BasePart") then
			desc.CanCollide = not enabled
		end
	end
end

local function tweenCharacterToPosition(destination, speed, failConditionFn)
	if not guardSoloServer(failConditionFn) then
		return false
	end

	speed = math.max(speed or BOX_TWEEN_SPEED, 1)
	local primary = getRoot()
	if not primary then
		return false
	end

	local startPos = primary.Position
	local distance = (destination - startPos).Magnitude
	if distance < 0.5 then
		return true
	end

	local duration = distance / speed
	local lookDir = (destination - startPos).Unit
	local flatDir = Vector3.new(lookDir.X, 0, lookDir.Z)
	local goalCFrame = flatDir.Magnitude > 0.001
		and CFrame.lookAt(destination, destination + flatDir)
		or CFrame.new(destination)

	local proxy = Instance.new("CFrameValue")
	proxy.Value = primary.CFrame

	local paused = false
	local conn = proxy.Changed:Connect(function(newCFrame)
		if (failConditionFn and failConditionFn()) or isPlayerDead() then
			rejoinSameServer(QUEUE_RESPAWN_HANDLER)
			return
		end

		if hasOtherPlayers() then
			paused = true
			return
		end

		paused = false
		local character = getCharacter()
		if character then
			character:PivotTo(newCFrame)
		end
	end)

	local tween = TweenService:Create(
		proxy,
		TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
		{ Value = goalCFrame }
	)

	tween:Play()
	while tween.PlaybackState == Enum.PlaybackState.Playing do
		if (failConditionFn and failConditionFn()) or isPlayerDead() then
			tween:Cancel()
			conn:Disconnect()
			proxy:Destroy()
			rejoinSameServer(QUEUE_RESPAWN_HANDLER)
			return false
		end

		if hasOtherPlayers() then
			tween:Pause()
			while hasOtherPlayers() and not isPlayerDead() and not (failConditionFn and failConditionFn()) do
				task.wait(0.2)
			end
			if (failConditionFn and failConditionFn()) or isPlayerDead() then
				tween:Cancel()
				conn:Disconnect()
				proxy:Destroy()
				rejoinSameServer(QUEUE_RESPAWN_HANDLER)
				return false
			end
			tween:Play()
		end

		RunService.Heartbeat:Wait()
	end

	conn:Disconnect()
	proxy:Destroy()
	return not paused and not isPlayerDead() and not (failConditionFn and failConditionFn())
end

local function findProximityPrompt(container)
	if not container then
		return nil
	end
	return container:FindFirstChildWhichIsA("ProximityPrompt", true)
end

local function fireVentTouchAndPrompt()
	if not guardSoloServer(isJewelLocked) then
		return false
	end

	local jewelryStore = Workspace:FindFirstChild("JewelryStore")
	local vent = jewelryStore and jewelryStore:FindFirstChild("JewelryVent")
	local trigger = vent and vent:FindFirstChild("Trigger")
	local prompt = findProximityPrompt(trigger) or findProximityPrompt(vent) or findProximityPrompt(jewelryStore)

	local root = getRoot()
	if trigger and trigger:IsA("BasePart") and root then
		local oldCFrame = root.CFrame
		root.CFrame = trigger.CFrame * CFrame.new(0, 0, -2)
		task.wait(0.05)

		local touchInterest = trigger:FindFirstChildOfClass("TouchTransmitter") or trigger:FindFirstChild("TouchInterest")
		if typeof(firetouchinterest) == "function" then
			pcall(firetouchinterest, root, trigger, 0)
			task.wait(0.04)
			pcall(firetouchinterest, root, trigger, 1)
		elseif touchInterest then
			root.CFrame = trigger.CFrame
			task.wait(0.05)
		end

		if prompt then
			prompt.HoldDuration = 0
			prompt:InputHoldBegin()
			task.wait(0.05)
			prompt:InputHoldEnd()
			if typeof(fireproximityprompt) == "function" then
				pcall(fireproximityprompt, prompt)
			end
		end

		root.CFrame = oldCFrame
		return true
	end

	if prompt then
		prompt.HoldDuration = 0
		if typeof(fireproximityprompt) == "function" then
			pcall(fireproximityprompt, prompt)
		end
		return true
	end

	return false
end

local function getCashAmountLabel()
	local lp = getLocalPlayer()
	local playerGui = lp:FindFirstChild("PlayerGui")
	local mainGui = playerGui and playerGui:FindFirstChild("MainGUI")
	local statsHud = mainGui and mainGui:FindFirstChild("StatsHUD")
	local cashBagHud = statsHud and statsHud:FindFirstChild("CashBagHUD")
	local cash = cashBagHud and cashBagHud:FindFirstChild("Cash")
	return cash and cash:FindFirstChild("Amount")
end

local function hasReachedCashTarget(targetText)
	local label = getCashAmountLabel()
	if not label or not label:IsA("TextLabel") then
		return false
	end

	return string.gsub(label.Text, "%s+", "") == targetText
end

local function isJewelryBox(instance, jewelryBoxesFolder)
	if not instance or instance == jewelryBoxesFolder or instance.Name == "JewelryManager" then
		return false
	end

	return instance:IsA("BasePart") or instance:IsA("Model")
end

local function fireBoxRemote(event, box, firesPerBox)
	for _ = 1, firesPerBox do
		event:FireServer(box, true)
	end
end

local function fireAllJewelryBoxesAtOnce(jewelryBoxesFolder, event, firesPerBox)
	local firedCount = 0
	for _, child in ipairs(jewelryBoxesFolder:GetChildren()) do
		if isJewelryBox(child, jewelryBoxesFolder) then
			fireBoxRemote(event, child, firesPerBox)
			firedCount = firedCount + 1
		end
	end
	return firedCount
end

local function collectAllJewelryBoxes(jewelryBoxesFolder)
	local boxes = {}
	for _, child in ipairs(jewelryBoxesFolder:GetChildren()) do
		if isJewelryBox(child, jewelryBoxesFolder) and getInstancePosition(child) then
			table.insert(boxes, child)
		end
	end
	return boxes
end

local function findNextBoxToTween(boxes, currentIndex)
	if #boxes == 0 then
		return nil, currentIndex
	end

	for offset = 0, #boxes - 1 do
		local idx = ((currentIndex - 1 + offset) % #boxes) + 1
		local box = boxes[idx]
		if box and box.Parent and getInstancePosition(box) then
			return box, (idx % #boxes) + 1
		end
	end

	return nil, currentIndex
end

local function runJewelryBoxFarmUntilTargetCash()
	if not guardHeistCondition(isJewelLocked) then
		return false
	end

	local jewelryStore = Workspace:FindFirstChild("JewelryStore")
	local jewelryBoxesFolder = jewelryStore and jewelryStore:FindFirstChild("JewelryBoxes")
	local manager = jewelryBoxesFolder and jewelryBoxesFolder:FindFirstChild("JewelryManager")
	local event = manager and manager:FindFirstChild("Event")

	if not jewelryBoxesFolder or not event or not event:IsA("RemoteEvent") then
		warn("JewelryBoxes or JewelryManager.Event not found")
		return false
	end

	local boxes = collectAllJewelryBoxes(jewelryBoxesFolder)
	local startClock = os.clock()
	local nextIndex = 1

	local noclipConn = RunService.Stepped:Connect(function()
		if not hasOtherPlayers() and not isPlayerDead() and not isJewelLocked() then
			setCharacterNoclip(true)
		end
	end)

	while not hasReachedCashTarget(JEWEL_TARGET_CASH) do
		if isJewelLocked() or isPlayerDead() then
			noclipConn:Disconnect()
			rejoinSameServer(QUEUE_RESPAWN_HANDLER)
			return false
		end

		if hasOtherPlayers() then
			while hasOtherPlayers() and not isPlayerDead() and not isJewelLocked() do
				task.wait(0.25)
			end
			if isJewelLocked() or isPlayerDead() then
				noclipConn:Disconnect()
				rejoinSameServer(QUEUE_RESPAWN_HANDLER)
				return false
			end
		end

		if MAX_FARM_SECONDS and (os.clock() - startClock) >= MAX_FARM_SECONDS then
			warn("Reached MAX_FARM_SECONDS before hitting " .. JEWEL_TARGET_CASH)
			break
		end

		setCharacterNoclip(true)
		fireAllJewelryBoxesAtOnce(jewelryBoxesFolder, event, FIRES_PER_BOX)

		local targetBox
		targetBox, nextIndex = findNextBoxToTween(boxes, nextIndex)
		if targetBox then
			local boxPos = getInstancePosition(targetBox)
			if boxPos and guardSoloServer(isJewelLocked) then
				tweenCharacterToPosition(boxPos + Vector3.new(0, BOX_Y_OFFSET, 0), BOX_TWEEN_SPEED, isJewelLocked)
			end
		end

		if isJewelLocked() or isPlayerDead() then
			noclipConn:Disconnect()
			rejoinSameServer(QUEUE_RESPAWN_HANDLER)
			return false
		end

		if hasReachedCashTarget(JEWEL_TARGET_CASH) then
			break
		end

		if not hasOtherPlayers() and not isJewelLocked() then
			fireAllJewelryBoxesAtOnce(jewelryBoxesFolder, event, FIRES_PER_BOX)
		end

		RunService.Heartbeat:Wait()
	end

	noclipConn:Disconnect()
	setCharacterNoclip(false)
	return not isPlayerDead() and not isJewelLocked()
end

local function collectCasinoLeverEvents()
	local events = {}
	local seen = {}

	local function addEvent(ev)
		if ev and ev:IsA("RemoteEvent") and not seen[ev] then
			seen[ev] = true
			table.insert(events, ev)
		end
	end

	local objectSelection = Workspace:FindFirstChild("ObjectSelection")
	if objectSelection then
		for _, child in ipairs(objectSelection:GetChildren()) do
			if child.Name == "Lever" then
				local lever2 = child:FindFirstChild("Lever")
				local lever3 = lever2 and lever2:FindFirstChild("Lever")
				local ev = lever3 and lever3:FindFirstChild("Event")
				addEvent(ev)

				for _, desc in ipairs(child:GetDescendants()) do
					if desc.Name == "Event" and desc:IsA("RemoteEvent") then
						addEvent(desc)
					end
				end
			end
		end
	end

	if #events == 0 then
		for _, desc in ipairs(Workspace:GetDescendants()) do
			if desc.Name == "Event" and desc:IsA("RemoteEvent") and desc.Parent and desc.Parent.Name == "Lever" then
				addEvent(desc)
			end
		end
	end

	return events
end

local function fireAllCasinoLeversOnce(events)
	local firedCount = 0
	for _, ev in ipairs(events) do
		if ev and ev.Parent then
			for _ = 1, FIRES_PER_LEVER do
				pcall(function()
					ev:FireServer()
				end)
			end
			firedCount = firedCount + 1
		end
	end
	return firedCount
end

local function runCasinoFarmUntilTargetCash()
	if not guardHeistCondition(isCasinoLocked) then
		return false
	end

	local leverEvents = collectCasinoLeverEvents()
	local deadline = os.clock() + 10
	while #leverEvents < 4 and os.clock() < deadline do
		if not guardSoloServer(isCasinoLocked) then
			return false
		end
		task.wait(0.25)
		leverEvents = collectCasinoLeverEvents()
	end

	fireAllCasinoLeversOnce(leverEvents)

	local startClock = os.clock()
	local nextLeverFireClock = os.clock() + 1.5

	local noclipConn = RunService.Stepped:Connect(function()
		if not hasOtherPlayers() and not isPlayerDead() and not isCasinoLocked() then
			setCharacterNoclip(true)
		end
	end)

	while not hasReachedCashTarget(CASINO_TARGET_CASH) do
		if isCasinoLocked() or isPlayerDead() then
			noclipConn:Disconnect()
			rejoinSameServer(QUEUE_RESPAWN_HANDLER)
			return false
		end

		if hasOtherPlayers() then
			while hasOtherPlayers() and not isPlayerDead() and not isCasinoLocked() do
				task.wait(0.25)
			end
			if isCasinoLocked() or isPlayerDead() then
				noclipConn:Disconnect()
				rejoinSameServer(QUEUE_RESPAWN_HANDLER)
				return false
			end
		end

		if os.clock() >= nextLeverFireClock then
			leverEvents = collectCasinoLeverEvents()
			fireAllCasinoLeversOnce(leverEvents)
			nextLeverFireClock = os.clock() + 1.5
		end

		if MAX_FARM_SECONDS and (os.clock() - startClock) >= MAX_FARM_SECONDS then
			warn("Reached MAX_FARM_SECONDS waiting for " .. CASINO_TARGET_CASH)
			break
		end

		task.wait(0.2)
	end

	noclipConn:Disconnect()
	setCharacterNoclip(false)
	return not isPlayerDead() and not isCasinoLocked()
end

