local function getStatsHud()
	local lp = getLocalPlayer()
	local playerGui = lp:FindFirstChild("PlayerGui")
	local mainGui = playerGui and playerGui:FindFirstChild("MainGUI")
	return mainGui and mainGui:FindFirstChild("StatsHUD")
end

local function getCashAmountLabel()
	local statsHud = getStatsHud()
	local cashBagHud = statsHud and statsHud:FindFirstChild("CashBagHUD")
	local cash = cashBagHud and cashBagHud:FindFirstChild("Cash")
	return cash and cash:FindFirstChild("Amount")
end

local function readHudText(pathFn)
	local ok, result = pcall(pathFn)
	if ok and result then
		if typeof(result) == "Instance" and (result:IsA("TextLabel") or result:IsA("TextBox") or result:IsA("TextButton")) then
			return tostring(result.Text)
		end
		return tostring(result)
	end
	return "..."
end

local function attachOverlayGui(gui)
	gui.ResetOnSpawn = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

	local okParent = pcall(function()
		gui.Parent = CoreGui
	end)
	if not okParent or not gui.Parent then
		local lp = getLocalPlayer()
		gui.Parent = lp:WaitForChild("PlayerGui")
	end
end

local function createStatsOverlay()
	local existing = CoreGui:FindFirstChild("HeistStatsOverlay")
	if existing then
		existing:Destroy()
	end
	local lp = getLocalPlayer()
	local pg = lp:FindFirstChild("PlayerGui")
	if pg and pg:FindFirstChild("HeistStatsOverlay") then
		pg.HeistStatsOverlay:Destroy()
	end

	local gui = Instance.new("ScreenGui")
	gui.Name = "HeistStatsOverlay"
	attachOverlayGui(gui)

	local frame = Instance.new("Frame")
	frame.Name = "Panel"
	frame.Position = UDim2.new(0, 12, 0.5, -56)
	frame.Size = UDim2.new(0, 235, 0, 112)
	frame.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
	frame.BackgroundTransparency = 0.2
	frame.BorderSizePixel = 0
	frame.Parent = gui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = frame

	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 8)
	padding.PaddingBottom = UDim.new(0, 8)
	padding.PaddingLeft = UDim.new(0, 10)
	padding.PaddingRight = UDim.new(0, 10)
	padding.Parent = frame

	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 4)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = frame

	local function makeLabel(name, order, color)
		local lbl = Instance.new("TextLabel")
		lbl.Name = name
		lbl.LayoutOrder = order
		lbl.Size = UDim2.new(1, 0, 0, 20)
		lbl.BackgroundTransparency = 1
		lbl.Font = Enum.Font.GothamSemibold
		lbl.TextSize = 14
		lbl.TextColor3 = color
		lbl.TextXAlignment = Enum.TextXAlignment.Left
		lbl.TextTruncate = Enum.TextTruncate.AtEnd
		lbl.Text = name .. ": ..."
		lbl.Parent = frame
		return lbl
	end

	local cashLabel = makeLabel("Cash", 1, Color3.fromRGB(120, 240, 150))
	local levelLabel = makeLabel("Level", 2, Color3.fromRGB(140, 195, 255))
	local xpLabel = makeLabel("XP", 3, Color3.fromRGB(235, 210, 125))
	local stepLabel = makeLabel("Step", 4, Color3.fromRGB(220, 225, 235))
	stepLabel.Text = "Step: " .. currentStepText
	stepLabelRef = stepLabel

	task.spawn(function()
		while true do
			if not gui.Parent then
				attachOverlayGui(gui)
			end

			local statsHud = getStatsHud()

			local cashText = readHudText(function()
				return statsHud.CashHUD.Cash.Amount
			end)
			local levelText = readHudText(function()
				return statsHud.LevelHUD.Level.Level
			end)
			local xpText = readHudText(function()
				return statsHud.LevelHUD.Bar.Title
			end)

			cashLabel.Text = "Cash: " .. cashText
			levelLabel.Text = "Level: " .. levelText
			xpLabel.Text = "XP: " .. xpText
			stepLabel.Text = "Step: " .. currentStepText

			task.wait(0.25)
		end
	end)
end

--------------------------------------------------------------------------------
-- CASH TARGET HELPERS
--------------------------------------------------------------------------------

local function hasReachedCashTarget(targetText)
	local label = getCashAmountLabel()
	if not label or not label:IsA("TextLabel") then
		return false
	end

	return string.gsub(label.Text, "%s+", "") == targetText
end

-- Shared farm loop body: waits until cash target reached while handling
-- death / heist-locked / other-player idling. Returns "target", "timeout" or "fail".
local function runCashTargetLoop(targetText, failConditionFn)
	local startClock = os.clock()
	while not hasReachedCashTarget(targetText) do
		if (failConditionFn and failConditionFn()) or isPlayerDead() then
			rejoinSameServer(QUEUE_RESPAWN_HANDLER)
			return "fail"
		end

		if hasOtherPlayers() then
			if not waitForServerEmpty(failConditionFn, "Robbing (" .. targetText .. ")") then
				return "fail"
			end
		end

		if (failConditionFn and failConditionFn()) or isPlayerDead() then
			rejoinSameServer(QUEUE_RESPAWN_HANDLER)
			return "fail"
		end

		if MAX_FARM_SECONDS and (os.clock() - startClock) >= MAX_FARM_SECONDS then
			warn("Reached MAX_FARM_SECONDS waiting for " .. targetText)
			return "timeout"
		end

		task.wait(0.2)
	end
	return "target"
end

-- Shared noclip pump: keeps noclip on only while solo, alive and heist open.
local function startNoclipPump(failConditionFn)
	return RunService.Stepped:Connect(function()
		if not hasOtherPlayers() and not isPlayerDead() and not (failConditionFn and failConditionFn()) then
			setCharacterNoclip(true)
		end
	end)
end

local function stopNoclipPump(conn)
	if conn then
		conn:Disconnect()
	end
	setCharacterNoclip(false)
end

--------------------------------------------------------------------------------
-- JEWELRY HEIST
--------------------------------------------------------------------------------

local function getInstancePosition(target)
	if not target then
		return nil
	end

	if target:IsA("BasePart") then
		return target.Position
	end

	if target:IsA("Model") then
		local primary = target.PrimaryPart or target:FindFirstChildWhichIsA("BasePart", true)
		if primary then
			return primary.Position
		end
	end

	local part = target:FindFirstChildWhichIsA("BasePart", true)
	return part and part.Position
end

local function findProximityPrompt(container)
	if not container then
		return nil
	end
	return container:FindFirstChildWhichIsA("ProximityPrompt", true)
end

local function fireVentTouchAndPrompt()
	if not guardSoloServer(isJewelLocked) then
		return false
	end

	setStepStatus("Entering Jewelry vent...")
	local jewelryStore = Workspace:FindFirstChild("JewelryStore")
	local vent = jewelryStore and jewelryStore:FindFirstChild("JewelryVent")
	local trigger = vent and vent:FindFirstChild("Trigger")
	local prompt = findProximityPrompt(trigger) or findProximityPrompt(vent) or findProximityPrompt(jewelryStore)

	local root = getRoot()
	if trigger and trigger:IsA("BasePart") and root then
		local oldCFrame = root.CFrame
		root.CFrame = trigger.CFrame * CFrame.new(0, 0, -2)
		task.wait(0.05)

		local touchInterest = trigger:FindFirstChildOfClass("TouchTransmitter") or trigger:FindFirstChild("TouchInterest")
		if typeof(firetouchinterest) == "function" then
			pcall(firetouchinterest, root, trigger, 0)
			task.wait(0.04)
			pcall(firetouchinterest, root, trigger, 1)
		elseif touchInterest then
			root.CFrame = trigger.CFrame
			task.wait(0.05)
		end

		if prompt then
			prompt.HoldDuration = 0
			prompt:InputHoldBegin()
			task.wait(0.05)
			prompt:InputHoldEnd()
			if typeof(fireproximityprompt) == "function" then
				pcall(fireproximityprompt, prompt)
			end
		end

		root.CFrame = oldCFrame
		return true
	end

	if prompt then
		prompt.HoldDuration = 0
		if typeof(fireproximityprompt) == "function" then
			pcall(fireproximityprompt, prompt)
		end
		return true
	end

	return false
end

local function isJewelryBox(instance, jewelryBoxesFolder)
	if not instance or instance == jewelryBoxesFolder or instance.Name == "JewelryManager" then
		return false
	end

	return instance:IsA("BasePart") or instance:IsA("Model")
end

local function fireBoxRemote(event, box, firesPerBox)
	for _ = 1, firesPerBox do
		event:FireServer(box, true)
	end
end

local function fireAllJewelryBoxesAtOnce(jewelryBoxesFolder, event, firesPerBox)
	local firedCount = 0
	for _, child in ipairs(jewelryBoxesFolder:GetChildren()) do
		if isJewelryBox(child, jewelryBoxesFolder) then
			fireBoxRemote(event, child, firesPerBox)
			firedCount = firedCount + 1
		end
	end
	return firedCount
end

local function collectAllJewelryBoxes(jewelryBoxesFolder)
	local boxes = {}
	for _, child in ipairs(jewelryBoxesFolder:GetChildren()) do
		if isJewelryBox(child, jewelryBoxesFolder) and getInstancePosition(child) then
			table.insert(boxes, child)
		end
	end
	return boxes
end

local function findNextBoxToTween(boxes, currentIndex)
	if #boxes == 0 then
		return nil, currentIndex
	end

	for offset = 0, #boxes - 1 do
		local idx = ((currentIndex - 1 + offset) % #boxes) + 1
		local box = boxes[idx]
		if box and box.Parent and getInstancePosition(box) then
			return box, (idx % #boxes) + 1
		end
	end

	return nil, currentIndex
end

local function runJewelryBoxFarmUntilTargetCash()
	if not guardHeistCondition(isJewelLocked) then
		return false
	end

	setStepStatus("Robbing Jewelry (" .. JEWEL_TARGET_CASH .. ")")

	local jewelryStore = Workspace:FindFirstChild("JewelryStore")
	local jewelryBoxesFolder = jewelryStore and jewelryStore:FindFirstChild("JewelryBoxes")
	local manager = jewelryBoxesFolder and jewelryBoxesFolder:FindFirstChild("JewelryManager")
	local event = manager and manager:FindFirstChild("Event")

	if not jewelryBoxesFolder or not event or not event:IsA("RemoteEvent") then
		warn("JewelryBoxes or JewelryManager.Event not found")
		return false
	end

	local boxes = collectAllJewelryBoxes(jewelryBoxesFolder)
	local startClock = os.clock()
	local nextIndex = 1
	local noclipConn = startNoclipPump(isJewelLocked)

	isMidHeist = true

	while not hasReachedCashTarget(JEWEL_TARGET_CASH) do
		if isJewelLocked() or isPlayerDead() then
			isMidHeist = false
			stopNoclipPump(noclipConn)
			rejoinSameServer(QUEUE_RESPAWN_HANDLER)
			return false
		end

		if hasOtherPlayers() then
			if not waitForServerEmpty(isJewelLocked, "Robbing Jewelry (" .. JEWEL_TARGET_CASH .. ")") then
				isMidHeist = false
				stopNoclipPump(noclipConn)
				return false
			end
		end

		if MAX_FARM_SECONDS and (os.clock() - startClock) >= MAX_FARM_SECONDS then
			warn("Reached MAX_FARM_SECONDS before hitting " .. JEWEL_TARGET_CASH)
			break
		end

		setCharacterNoclip(true)
		fireAllJewelryBoxesAtOnce(jewelryBoxesFolder, event, FIRES_PER_BOX)

		local targetBox
		targetBox, nextIndex = findNextBoxToTween(boxes, nextIndex)
		if targetBox then
			local boxPos = getInstancePosition(targetBox)
			if boxPos and guardSoloServer(isJewelLocked) then
				tweenCharacterToPosition(boxPos + Vector3.new(0, BOX_Y_OFFSET, 0), BOX_TWEEN_SPEED, isJewelLocked)
			end
		end

		if isJewelLocked() or isPlayerDead() then
			isMidHeist = false
			stopNoclipPump(noclipConn)
			rejoinSameServer(QUEUE_RESPAWN_HANDLER)
			return false
		end

		if hasReachedCashTarget(JEWEL_TARGET_CASH) then
			break
		end

		if not hasOtherPlayers() and not isJewelLocked() then
			fireAllJewelryBoxesAtOnce(jewelryBoxesFolder, event, FIRES_PER_BOX)
		end

		RunService.Heartbeat:Wait()
	end

	isMidHeist = false
	stopNoclipPump(noclipConn)
	return not isPlayerDead() and not isJewelLocked()
end

