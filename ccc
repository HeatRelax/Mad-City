local bindDeathRejoin -- defined in "LOADING & DEATH HANDLING" below

--------------------------------------------------------------------------------
-- TEAM SWITCH
--------------------------------------------------------------------------------

local function setTeamToCriminals()
	local remoteFunc = ReplicatedStorage:FindFirstChild("RemoteFunction") or ReplicatedStorage:WaitForChild("RemoteFunction", 15)
	if not remoteFunc or not remoteFunc:IsA("RemoteFunction") then
		warn("ReplicatedStorage.RemoteFunction not found")
		return false
	end

	local ok, err = pcall(function()
		remoteFunc:InvokeServer("SetTeam", "Criminals")
	end)

	if not ok then
		warn("Failed to invoke SetTeam Criminals:", tostring(err))
		return false
	end

	return true
end

local function switchToCriminalsAndRespawn(nextStepLabel)
	local previousCharacter = getCharacter()
	setStepStatus("Switching team & respawning...")
	isSwitchingTeam = true
	setTeamToCriminals()

	local lp = getLocalPlayer()
	local deadline = os.clock() + 20
	local newChar = lp.Character

	if previousCharacter and newChar == previousCharacter then
		while os.clock() < deadline do
			newChar = lp.Character
			if newChar and newChar ~= previousCharacter and newChar.Parent then
				break
			end
			task.wait(0.05)
		end
	end

	while os.clock() < deadline do
		newChar = lp.Character
		if newChar and newChar.Parent then
			local hum = newChar:FindFirstChildOfClass("Humanoid")
			local root = newChar:FindFirstChild("HumanoidRootPart")
			if hum and root and hum.Health > 0 then
				isSwitchingTeam = false
				bindDeathRejoin()
				if nextStepLabel then
					setStepStatus(nextStepLabel)
				end
				return newChar
			end
		end
		task.wait(0.05)
	end

	isSwitchingTeam = false
	bindDeathRejoin()
	if nextStepLabel then
		setStepStatus(nextStepLabel)
	end
	return lp.Character
end

--------------------------------------------------------------------------------
-- PLAYER-PRESENCE HANDLER (idling while others are in the server)
--------------------------------------------------------------------------------

-- Anti-AFK: simulates real input via VirtualUser so Roblox's idle detection
-- (disconnect after ~20 minutes of no input) never fires during long waits.
-- This does NOT move the character or fire any game remotes - the character
-- stays perfectly still at the collect position while we wait.
local function runAntiAfkNudge()
	local ok, err = pcall(function()
		VirtualUser:CaptureController()
		VirtualUser:ClickButton2(Vector2.new())
	end)
	if not ok then
		warn("Anti-AFK nudge failed:", tostring(err))
	end
end

-- Central handler for "someone else is in the server":
-- 1. switch team to Criminals (once per hide),
-- 2. if mid-heist, teleport to FINAL_CFRAME and stay perfectly still,
-- 3. do NOTHING (no rejoin, no farming) until the server is solo again,
-- 4. resume whatever step was running.
-- Returns true when it is safe to resume, false when the step must abort (rejoin).
local function waitForServerEmpty(failConditionFn, resumeLabel)
	if not hasOtherPlayers() then
		return true
	end

	-- Hard-fail checks before idling
	if failConditionFn and failConditionFn() then
		rejoinSameServer(QUEUE_RESPAWN_HANDLER)
		return false
	end
	if isPlayerDead() then
		rejoinSameServer(QUEUE_RESPAWN_HANDLER)
		return false
	end

	isHiding = true
	setStepStatus("Player in server - idling...")

	-- Switch to Criminals (plain team set; no respawn-wait logic needed while idling)
	pcall(setTeamToCriminals)
	task.wait(0.5)

	local idleStartClock = os.clock()
	local lastAntiAfkClock = os.clock()

	while hasOtherPlayers() do
		-- While hiding we deliberately ignore heist-lock changes; we simply stay put
		-- doing nothing until the other player leaves.
		if isMidHeist then
			local character = getCharacter()
			local root = character and getRoot()
			if character and character.Parent and root and not isPlayerDead() then
				if (root.Position - FINAL_CFRAME.Position).Magnitude > HIDE_SNAP_DISTANCE then
					character:PivotTo(FINAL_CFRAME)
				end
			end
		end

		-- Anti-AFK nudge while waiting (resets Roblox's idle timer without moving us)
		if (os.clock() - lastAntiAfkClock) >= ANTI_AFK_INTERVAL then
			runAntiAfkNudge()
			lastAntiAfkClock = os.clock()
		end

		-- Live status with elapsed idle time so the overlay shows we are still waiting
		setStepStatus(string.format(
			"Player in server - idling (%ds)...",
			math.floor(os.clock() - idleStartClock)
		))

		task.wait(IDLE_CHECK_INTERVAL)
	end

	isHiding = false

	-- Server is solo again: normal resume checks
	if failConditionFn and failConditionFn() then
		rejoinSameServer(QUEUE_RESPAWN_HANDLER)
		return false
	end
	if isPlayerDead() then
		rejoinSameServer(QUEUE_RESPAWN_HANDLER)
		return false
	end

	if resumeLabel then
		setStepStatus(resumeLabel)
	end
	return true
end

local function guardHeistCondition(failConditionFn)
	if failConditionFn() then
		rejoinSameServer(QUEUE_RESPAWN_HANDLER)
		return false
	end
	return true
end

-- Guarantees we are solo + alive (+ optional heist condition) before an action.
local function guardSoloServer(failConditionFn)
	if failConditionFn and not guardHeistCondition(failConditionFn) then
		return false
	end

	if isPlayerDead() then
		rejoinSameServer(QUEUE_RESPAWN_HANDLER)
		return false
	end

	return waitForServerEmpty(failConditionFn, currentStepText)
end

--------------------------------------------------------------------------------
-- MOVEMENT
--------------------------------------------------------------------------------

local function setCharacterNoclip(enabled)
	local character = getCharacter()
	if not character then
		return
	end

	for _, desc in ipairs(character:GetDescendants()) do
		if desc:IsA("BasePart") then
			desc.CanCollide = not enabled
		end
	end
end

local function tweenCharacterToPosition(destination, speed, failConditionFn)
	if not guardSoloServer(failConditionFn) then
		return false
	end

	speed = math.max(speed or BOX_TWEEN_SPEED, 1)
	local primary = getRoot()
	if not primary then
		return false
	end

	local startPos = primary.Position
	local distance = (destination - startPos).Magnitude
	if distance < 0.5 then
		return true
	end

	local duration = distance / speed
	local lookDir = (destination - startPos).Unit
	local flatDir = Vector3.new(lookDir.X, 0, lookDir.Z)
	local goalCFrame = flatDir.Magnitude > 0.001
		and CFrame.lookAt(destination, destination + flatDir)
		or CFrame.new(destination)

	local proxy = Instance.new("CFrameValue")
	proxy.Value = primary.CFrame

	local paused = false
	local conn = proxy.Changed:Connect(function(newCFrame)
		if (failConditionFn and failConditionFn()) or isPlayerDead() then
			rejoinSameServer(QUEUE_RESPAWN_HANDLER)
			return
		end

		if hasOtherPlayers() then
			paused = true
			return
		end

		paused = false
		local character = getCharacter()
		if character then
			character:PivotTo(newCFrame)
		end
	end)

	local tween = TweenService:Create(
		proxy,
		TweenInfo.new(duration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out),
		{ Value = goalCFrame }
	)

	tween:Play()
	while tween.PlaybackState == Enum.PlaybackState.Playing do
		if (failConditionFn and failConditionFn()) or isPlayerDead() then
			tween:Cancel()
			conn:Disconnect()
			proxy:Destroy()
			rejoinSameServer(QUEUE_RESPAWN_HANDLER)
			return false
		end

		if hasOtherPlayers() then
			tween:Pause()
			if not waitForServerEmpty(failConditionFn, currentStepText) then
				tween:Cancel()
				conn:Disconnect()
				proxy:Destroy()
				return false
			end
			tween:Play()
		end

		RunService.Heartbeat:Wait()
	end

	conn:Disconnect()
	proxy:Destroy()
	return not paused and not isPlayerDead() and not (failConditionFn and failConditionFn())
end

local function pivotCharacterToCFrame(targetCFrame, failConditionFn, stepLabel)
	if stepLabel then
		setStepStatus(stepLabel)
	end

	if not guardSoloServer(failConditionFn) then
		return false
	end

	local character = getCharacter()
	if not character then
		warn("Character not found for teleport")
		return false
	end

	character:PivotTo(targetCFrame)
	return true
end

local function waitGuardedSeconds(seconds, failConditionFn, waitStepLabel)
	if waitStepLabel then
		setStepStatus(waitStepLabel)
	end

	local deadline = os.clock() + seconds
	while os.clock() < deadline do
		if not guardSoloServer(failConditionFn) then
			return false
		end
		task.wait(0.1)
	end
	return true
end

--------------------------------------------------------------------------------
-- LOADING & DEATH HANDLING
--------------------------------------------------------------------------------

local function waitForGameAndPlayerLoaded()
	setStepStatus("Waiting for game & character...")
	if not game:IsLoaded() then
		game.Loaded:Wait()
	end

	local lp = getLocalPlayer()
	while not lp.Character or not lp.Character.Parent do
		lp.CharacterAdded:Wait()
		task.wait(0.1)
	end

	local character = lp.Character
	local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 30)
	local root = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 30)

	while not humanoid or not root or humanoid.Health <= 0 do
		task.wait(0.1)
		character = lp.Character
		if not character or not character.Parent then
			lp.CharacterAdded:Wait()
			character = lp.Character
		end
		if character then
			humanoid = humanoid or character:FindFirstChildOfClass("Humanoid")
			root = root or character:FindFirstChild("HumanoidRootPart")
		end
	end

	if not Workspace.CurrentCamera then
		Workspace:GetPropertyChangedSignal("CurrentCamera"):Wait()
	end

	task.wait(0.3)
end

function bindDeathRejoin()
	local lp = getLocalPlayer()

	if deathConn then
		deathConn:Disconnect()
		deathConn = nil
	end
	if charAddedConn then
		charAddedConn:Disconnect()
		charAddedConn = nil
	end

	local function hookCharacter(char)
		if not char then
			return
		end
		if deathConn then
			deathConn:Disconnect()
			deathConn = nil
		end
		local hum = char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid", 30)
		if hum then
			deathConn = hum.Died:Connect(function()
				-- While idling (other players in server) we do NOT rejoin; waitForServerEmpty
				-- keeps running and the character respawns in place.
				if isHiding or isSwitchingTeam then
					return
				end
				setStepStatus("Died - rejoining...")
				rejoinSameServer(QUEUE_RESPAWN_HANDLER)
			end)
		end
	end

	hookCharacter(lp.Character)
	charAddedConn = lp.CharacterAdded:Connect(hookCharacter)
end

