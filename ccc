-- Teleport to FINAL_CFRAME, wait, and mark the heist as collected.
local function collectCashAtFinalPosition(stepLabel)
	if not pivotCharacterToCFrame(FINAL_CFRAME, nil, stepLabel) then
		return false
	end
	if not waitGuardedSeconds(COLLECT_WAIT_SECONDS, nil, stepLabel) then
		return false
	end
	isMidHeist = false
	return true
end

--[[
	tp(destination, lockedChecker, stepLabel)
	Main travel method: the SetTeam call is almost always followed by an immediate
	teleport to the heist destination, so this bundles the full pattern:
	guard -> switch to Criminals (respawn) -> guard -> noclip -> pivot -> noclip off.
	Marks the run as mid-heist on success.
]]
local function tp(destination, lockedChecker, stepLabel)
	if not guardSoloServer(lockedChecker) then
		return false
	end

	switchToCriminalsAndRespawn(stepLabel)
	if not guardSoloServer(lockedChecker) then
		return false
	end

	setCharacterNoclip(true)
	local ok = pivotCharacterToCFrame(CFrame.new(destination), lockedChecker, stepLabel)
	setCharacterNoclip(false)

	if not ok then
		return false
	end

	isMidHeist = true
	return true
end

local function executeFullSequence()
	waitForGameAndPlayerLoaded()
	createStatsOverlay()
	bindDeathRejoin()

	if not guardSoloServer(isJewelLocked) then
		return
	end

	-- 1. Switch to Criminals and TP to Jewelry vent top
	if not tp(VENT_DESTINATION, isJewelLocked, "Teleporting to Jewelry...") then
		return
	end

	setCharacterNoclip(true)
	if not fireVentTouchAndPrompt() then
		isMidHeist = false
		return
	end

	setCharacterNoclip(false)
	if not waitGuardedSeconds(VENT_WAIT_SECONDS, isJewelLocked, "Waiting at Jewelry vent...") then
		isMidHeist = false
		return
	end

	-- 2. Farm Jewelry until target cash
	if not runJewelryBoxFarmUntilTargetCash() then
		return
	end

	-- 3. Collect Jewelry cash at final position
	if not collectCashAtFinalPosition("Collecting Jewelry cash...") then
		return
	end

	-- 4. Club
	if not tp(CLUB_DESTINATION, isClubLocked, "Teleporting to Club...") then
		return
	end

	-- 5. Wait for Club cash and collect
	if not waitUntilHeistCashTarget(CLUB_TARGET_CASH, isClubLocked, "Robbing Club (" .. CLUB_TARGET_CASH .. ")") then
		return
	end
	if not collectCashAtFinalPosition("Collecting Club cash...") then
		return
	end

	-- 6. Casino
	if not tp(CASINO_DESTINATION, isCasinoLocked, "Teleporting to Casino...") then
		return
	end

	-- 7. Fire levers, wait for Casino cash, collect
	if not runCasinoFarmUntilTargetCash() then
		return
	end
	if not collectCashAtFinalPosition("Collecting Casino cash...") then
		return
	end

	-- 8. Bank
	if not tp(BANK_DESTINATION, isBankLocked, "Teleporting to Bank...") then
		return
	end

	-- 9. Wait for Bank cash, collect, then rejoin for a fresh run
	if not waitUntilHeistCashTarget(BANK_TARGET_CASH, isBankLocked, "Robbing Bank (" .. BANK_TARGET_CASH .. ")") then
		return
	end
	if not collectCashAtFinalPosition("Collecting Bank cash...") then
		return
	end

	if guardSoloServer() then
		rejoinSameServer(QUEUE_RESPAWN_HANDLER)
	end
end

