local function waitUntilHeistCashTarget(targetText, failConditionFn, robbingStepLabel)
	if failConditionFn and not guardHeistCondition(failConditionFn) then
		return false
	end

	setStepStatus(robbingStepLabel or ("Robbing (" .. targetText .. ")"))
	local noclipConn = startNoclipPump(failConditionFn)

	isMidHeist = true
	local outcome = runCashTargetLoop(targetText, failConditionFn)
	isMidHeist = false

	stopNoclipPump(noclipConn)

	if outcome == "fail" then
		return false
	end
	return not isPlayerDead() and not (failConditionFn and failConditionFn())
end

