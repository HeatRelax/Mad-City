local function collectCasinoLeverEvents()
	local events = {}
	local seen = {}

	local function addEvent(ev)
		if ev and ev:IsA("RemoteEvent") and not seen[ev] then
			seen[ev] = true
			table.insert(events, ev)
		end
	end

	local objectSelection = Workspace:FindFirstChild("ObjectSelection")
	if objectSelection then
		for _, child in ipairs(objectSelection:GetChildren()) do
			if child.Name == "Lever" then
				local lever2 = child:FindFirstChild("Lever")
				local lever3 = lever2 and lever2:FindFirstChild("Lever")
				local ev = lever3 and lever3:FindFirstChild("Event")
				addEvent(ev)

				for _, desc in ipairs(child:GetDescendants()) do
					if desc.Name == "Event" and desc:IsA("RemoteEvent") then
						addEvent(desc)
					end
				end
			end
		end
	end

	if #events == 0 then
		for _, desc in ipairs(Workspace:GetDescendants()) do
			if desc.Name == "Event" and desc:IsA("RemoteEvent") and desc.Parent and desc.Parent.Name == "Lever" then
				addEvent(desc)
			end
		end
	end

	return events
end

local function fireAllCasinoLeversOnce(events)
	local firedCount = 0
	for _, ev in ipairs(events) do
		if ev and ev.Parent then
			for _ = 1, FIRES_PER_LEVER do
				pcall(function()
					ev:FireServer()
				end)
			end
			firedCount = firedCount + 1
		end
	end
	return firedCount
end

local function runCasinoFarmUntilTargetCash()
	if not guardHeistCondition(isCasinoLocked) then
		return false
	end

	setStepStatus("Robbing Casino (" .. CASINO_TARGET_CASH .. ")")

	local leverEvents = collectCasinoLeverEvents()
	local deadline = os.clock() + 10
	while #leverEvents < 4 and os.clock() < deadline do
		if not guardSoloServer(isCasinoLocked) then
			return false
		end
		task.wait(0.25)
		leverEvents = collectCasinoLeverEvents()
	end

	fireAllCasinoLeversOnce(leverEvents)

	local startClock = os.clock()
	local nextLeverFireClock = os.clock() + LEVER_REFIRE_INTERVAL
	local noclipConn = startNoclipPump(isCasinoLocked)

	isMidHeist = true

	while not hasReachedCashTarget(CASINO_TARGET_CASH) do
		if isCasinoLocked() or isPlayerDead() then
			isMidHeist = false
			stopNoclipPump(noclipConn)
			rejoinSameServer(QUEUE_RESPAWN_HANDLER)
			return false
		end

		if hasOtherPlayers() then
			if not waitForServerEmpty(isCasinoLocked, "Robbing Casino (" .. CASINO_TARGET_CASH .. ")") then
				isMidHeist = false
				stopNoclipPump(noclipConn)
				return false
			end
		end

		if os.clock() >= nextLeverFireClock then
			leverEvents = collectCasinoLeverEvents()
			fireAllCasinoLeversOnce(leverEvents)
			nextLeverFireClock = os.clock() + LEVER_REFIRE_INTERVAL
		end

		if MAX_FARM_SECONDS and (os.clock() - startClock) >= MAX_FARM_SECONDS then
			warn("Reached MAX_FARM_SECONDS waiting for " .. CASINO_TARGET_CASH)
			break
		end

		task.wait(0.2)
	end

	isMidHeist = false
	stopNoclipPump(noclipConn)
	return not isPlayerDead() and not isCasinoLocked()
end

