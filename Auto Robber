--[[
	Mad City Auto Robber
	Entry point. Downloads the maintained source and runs it.

	Source: https://github.com/LuaSecurity/Perfect/tree/main/Auto%20Robber
]]

local mainUrl = "https://raw.githubusercontent.com/LuaSecurity/Perfect/refs/heads/main/Auto%20Robber/Main.lua"

local function fetchSource(url)
	local lastError

	for attempt = 1, 3 do
		local ok, source = pcall(function()
			return game:HttpGet(url .. "?t=" .. os.time())
		end)

		if ok and type(source) == "string" and source ~= "" and not source:match("^404:") then
			return source
		end

		if not ok then
			lastError = tostring(source)
		elseif type(source) ~= "string" or source == "" then
			lastError = "empty response"
		else
			lastError = source:sub(1, 160)
		end

		if attempt < 3 then
			task.wait(0.5)
		end
	end

	error("Failed to download " .. url .. "\n" .. tostring(lastError), 0)
end

local chunk, compileError = loadstring(fetchSource(mainUrl))
if not chunk then
	error("Failed to compile " .. mainUrl .. ": " .. tostring(compileError), 0)
end

return chunk()
